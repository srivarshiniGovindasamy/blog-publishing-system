# ============================================================
# Blog Publishing System - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
#
# For XAMPP/phpMyAdmin local MySQL, defaults are:
#   DB_HOST=localhost
#   DB_PORT=3306
#   DB_USER=root
#   DB_PASSWORD=        (empty by default in XAMPP)
# ============================================================

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-secret-key
FLASK_DEBUG=True
SESSION_COOKIE_SECURE=False

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=blog_publishing_system
DB_USER=root
DB_PASSWORD=

# Optional comma-separated abusive-language terms; built-in rules apply if unset.
# COMMENT_ABUSIVE_TERMS=

# Optional controlled admin seeding (used only by seed.py).
# Set all three values in your local .env file; do not commit real credentials.
#ADMIN_NAME=varshini
 #ADMIN_EMAIL=varshini9627@gmail.com
 #ADMIN_PASSWORD=98765432
